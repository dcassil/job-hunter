#!/bin/sh
# Guardrail: block commits that fail validation/lint/format.
echo "Running job-hunter guardrails (npm run check)..."
npm run check
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "Commit blocked: npm run check failed. Fix the issues above."
  echo "Do NOT loosen lint/schema rules to pass — see AGENTS.md."
  exit 1
fi
exit 0
